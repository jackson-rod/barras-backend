# Every variable the binaries read, with a value that works on a developer machine.
# Each one is required: a binary that misses one names it and does not start.

# Where the binary runs: local writes readable logs, staging and production write JSON.
APP_ENV=local
# The lowest level the logs write: trace, debug, info, warn or error.
LOG_LEVEL=info
# barras-api: the public API, under /api/v1.
API_BIND_ADDR=127.0.0.1:8080
# barras-api: the internal port, with the health of each dependency and the metrics.
API_INTERNAL_BIND_ADDR=127.0.0.1:9080
# barras-ingest: the internal port, with the health of each dependency and the metrics.
INGEST_INTERNAL_BIND_ADDR=127.0.0.1:9081
