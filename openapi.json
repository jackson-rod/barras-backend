{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "description": "What failed: the stable code to choose a text by and, on a validation failure only, the\nmessages for each field path.",
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The body of every error response. `success` is always false, `data` is always null and\n`code` is always the HTTP status of the response.",
        "properties": {
          "code": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "code",
          "error"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "description": "How the service stands.",
        "properties": {
          "status": {
            "description": "`ok`, or `degraded` while a dependency the service can do without is down.",
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "SuccessEnvelope_HealthStatus": {
        "description": "The body of every successful response. `success` is always true and `code` is always the\nHTTP status of the response.",
        "properties": {
          "code": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "data": {
            "description": "How the service stands.",
            "properties": {
              "status": {
                "description": "`ok`, or `degraded` while a dependency the service can do without is down.",
                "enum": [
                  "ok",
                  "degraded"
                ],
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Barras API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Every probe of a dependency runs at once, each with two seconds to answer. The answer is\n`ok` when every probe passes and `degraded` when only probes of optional dependencies fail.\nRequests that arrive while the probes run share their answer, and an answer less than one\nsecond old is given again.",
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_HealthStatus"
                }
              }
            },
            "description": "The service can take traffic: `ok`, or `degraded` while a dependency it can do without is down"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "A dependency the service needs is down"
          }
        },
        "summary": "Whether the service can take traffic.",
        "tags": [
          "health"
        ],
        "x-error-codes": [
          "SERVICE_UNAVAILABLE"
        ],
        "x-permission": "public",
        "x-plan-feature": "none"
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "No probe runs: the answer is `ok` for as long as the process can answer at all.",
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_HealthStatus"
                }
              }
            },
            "description": "The process is running"
          }
        },
        "summary": "Whether the process is running.",
        "tags": [
          "health"
        ],
        "x-error-codes": [],
        "x-permission": "public",
        "x-plan-feature": "none"
      }
    }
  },
  "x-common-error-codes": [
    "INTERNAL_ERROR",
    "MALFORMED_REQUEST",
    "METHOD_NOT_ALLOWED",
    "NOT_ACCEPTABLE",
    "PAYLOAD_TOO_LARGE",
    "REQUEST_TIMEOUT",
    "ROUTE_NOT_FOUND",
    "UNSUPPORTED_MEDIA_TYPE"
  ]
}
